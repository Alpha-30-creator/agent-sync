{
  "name": "@abdur-codes/agent-sync",
  "version": "0.0.1",
  "description": "Sync skills and MCP servers across Claude Code, Codex, and Cursor \u2014 and across your devices",
  "keywords": [
    "agent-skills",
    "mcp",
    "claude-code",
    "codex",
    "cursor",
    "sync",
    "cli"
  ],
  "license": "MIT",
  "author": "Muhammad Abdur Rahman Saad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alpha-30-creator/agent-sync.git"
  },
  "homepage": "https://github.com/Alpha-30-creator/agent-sync#readme",
  "bugs": {
    "url": "https://github.com/Alpha-30-creator/agent-sync/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "bin": {
    "agent-sync": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/chmod-bin.mjs && node scripts/build-skillpack.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:deps": "depcruise src --config .dependency-cruiser.cjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm check:deps && pnpm coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "dependency-cruiser": "^18.2.0",
    "fast-check": "^4.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
